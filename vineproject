#!/usr/bin/env sh
# Copyright (c) 2026 George Gilman
# SPDX-License-Identifier: MIT
#
# Combined macOS / Linux / Git Bash Launcher & One-Line Web Installer
# One-Line Web Install:
#   curl -fsSL https://raw.githubusercontent.com/ggilman/vineprojection/main/vineproject | bash

set -e

REPO_OWNER="ggilman"
REPO_NAME="vineprojection"
BRANCH="main"
TAR_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}/archive/refs/heads/${BRANCH}.tar.gz"

# Find a Python 3.9+ interpreter if installed
find_python() {
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1; then
            if "$candidate" -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" >/dev/null 2>&1; then
                command -v "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

# Determine script directory when run as a local file (vs piped via curl | bash)
SCRIPT_DIR=""
if [ -n "$0" ] && [ "$0" != "sh" ] && [ "$0" != "bash" ] && [ "$0" != "-sh" ] && [ "$0" != "-bash" ] && [ -f "$0" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
fi

PYTHON_BIN="$(find_python || true)"

# Fast Path: If install_deps.py sits next to this script and Python 3.9+ is available, launch immediately
if [ -n "$SCRIPT_DIR" ] && [ -f "$SCRIPT_DIR/install_deps.py" ] && [ -n "$PYTHON_BIN" ]; then
    exec "$PYTHON_BIN" "$SCRIPT_DIR/install_deps.py" "$@"
fi

# Interactive confirmation helper (reads from /dev/tty so curl | bash works interactively)
ask_confirm() {
    prompt_msg="$1"
    printf "%s [Y/n]: " "$prompt_msg"
    if [ -r /dev/tty ]; then
        read -r reply </dev/tty || reply=""
    else
        read -r reply || reply=""
    fi
    case "$reply" in
        ""|[Yy]|[Yy][Ee][Ss]) return 0 ;;
        *) return 1 ;;
    esac
}

if [ -n "$SCRIPT_DIR" ] && [ -f "$SCRIPT_DIR/app.py" ]; then
    INSTALL_DIR="$SCRIPT_DIR"
else
    INSTALL_DIR="$HOME/VineProjection"
fi

DESKTOP_DIR="$HOME/Desktop"

echo ""
echo "================================================================"
echo "  Vine ETV Analyzer - Setup Wizard"
echo "  Copyright (c) 2026 George Gilman (MIT License)"
echo "================================================================"
echo "  Target Folder    : $INSTALL_DIR"
if [ -n "$PYTHON_BIN" ]; then
    PY_VER="$("$PYTHON_BIN" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}")')"
    echo "  Python Status    : Found Python $PY_VER ($PYTHON_BIN)"
else
    echo "  Python Status    : Not found (Python 3.9+ will be installed)"
fi
echo "  Python Packages  : streamlit, pandas, openpyxl, plotly"
echo "  Desktop Launcher : $DESKTOP_DIR"
echo "  System PATH      : Not modified"
echo "================================================================"
echo ""

if ! ask_confirm "Proceed with installation?"; then
    echo "[INFO] Installation cancelled by user."
    exit 0
fi

# 1. Install Python 3 if missing
if [ -z "$PYTHON_BIN" ]; then
    echo ""
    if ! ask_confirm "Python 3.9+ is required. Install Python 3 using your system package manager now?"; then
        echo "[ERROR] Python 3.9+ is required to run the application." >&2
        exit 1
    fi

    OS_NAME="$(uname -s)"
    if [ "$OS_NAME" = "Darwin" ]; then
        if command -v brew >/dev/null 2>&1; then
            echo "[INSTALL] Installing Python via Homebrew..."
            brew install python
        else
            echo "[INSTALL] Triggering macOS Command Line Developer Tools installer (includes Python 3)..."
            xcode-select --install || true
            echo "[NOTICE] Please complete the macOS dialog if prompted, or install Python from https://www.python.org/downloads/ and re-run this command."
            exit 1
        fi
    elif command -v apt-get >/dev/null 2>&1; then
        echo "[INSTALL] Installing python3, python3-pip, and python3-venv via apt..."
        sudo apt-get update && sudo apt-get install -y python3 python3-pip python3-venv
    elif command -v dnf >/dev/null 2>&1; then
        echo "[INSTALL] Installing python3 and python3-pip via dnf..."
        sudo dnf install -y python3 python3-pip
    elif command -v pacman >/dev/null 2>&1; then
        echo "[INSTALL] Installing python and python-pip via pacman..."
        sudo pacman -Sy --noconfirm python python-pip
    else
        echo "[ERROR] Could not detect a supported package manager. Please install Python 3.9+ from https://www.python.org/downloads/ and re-run." >&2
        exit 1
    fi

    PYTHON_BIN="$(find_python || true)"
    if [ -z "$PYTHON_BIN" ]; then
        echo "[ERROR] Python 3.9+ is still not found after installation." >&2
        exit 1
    fi
fi

# 2. Download repository archive from GitHub if not already in a complete local directory
if [ ! -f "$INSTALL_DIR/app.py" ] || [ -z "$SCRIPT_DIR" ]; then
    echo ""
    echo "[DOWNLOAD] Downloading latest Vine ETV Analyzer from GitHub..."
    TMP_DIR="$(mktemp -d 2>/dev/null || mktemp -d -t 'vineproj_setup')"
    cleanup() { rm -rf "$TMP_DIR"; }
    trap cleanup EXIT

    mkdir -p "$INSTALL_DIR"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$TAR_URL" -o "$TMP_DIR/repo.tar.gz"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$TMP_DIR/repo.tar.gz" "$TAR_URL"
    else
        echo "[ERROR] Neither curl nor wget is available to download the repository." >&2
        exit 1
    fi

    tar -xzf "$TMP_DIR/repo.tar.gz" -C "$TMP_DIR"
    EXTRACTED_DIR="$(find "$TMP_DIR" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
    cp -R "$EXTRACTED_DIR"/. "$INSTALL_DIR"/
    chmod +x "$INSTALL_DIR/vineproject" "$INSTALL_DIR/install_deps.py" 2>/dev/null || true
    echo "[SUCCESS] Application files installed to $INSTALL_DIR"
fi

# 3. Create clickable Desktop launcher without modifying PATH
if [ -d "$DESKTOP_DIR" ]; then
    OS_NAME="$(uname -s)"
    if [ "$OS_NAME" = "Darwin" ]; then
        LAUNCHER_PATH="$DESKTOP_DIR/Vine ETV Analyzer.command"
        cat > "$LAUNCHER_PATH" <<EOF
#!/usr/bin/env sh
cd "$INSTALL_DIR" && exec ./vineproject
EOF
        chmod +x "$LAUNCHER_PATH"
        if [ -f "$INSTALL_DIR/icon.png" ] && command -v osascript >/dev/null 2>&1; then
            osascript -e "use framework \"AppKit\"" \
                      -e "set img to current application's NSImage's alloc()'s initWithContentsOfFile:\"$INSTALL_DIR/icon.png\"" \
                      -e "current application's NSWorkspace's sharedWorkspace()'s setIcon:img forFile:\"$LAUNCHER_PATH\" options:0" >/dev/null 2>&1 || true
        fi
        echo "[SUCCESS] Created Desktop launcher: $LAUNCHER_PATH"
    elif [ "$OS_NAME" = "Linux" ]; then
        LAUNCHER_PATH="$DESKTOP_DIR/Vine-ETV-Analyzer.desktop"
        cat > "$LAUNCHER_PATH" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Vine ETV Analyzer
Comment=Track your floating Amazon Vine ETV window and rolling cap decay
Exec="$INSTALL_DIR/vineproject"
Path=$INSTALL_DIR
Icon=$INSTALL_DIR/icon.png
Terminal=true
Categories=Office;Finance;Utility;
EOF
        chmod +x "$LAUNCHER_PATH"
        echo "[SUCCESS] Created Desktop launcher: $LAUNCHER_PATH"
    fi
fi

# 4. Hand off to install_deps.py (reconnect stdin to /dev/tty if piped from curl)
echo ""
echo "[LAUNCH] Starting dependency verification and application launcher..."
if [ -r /dev/tty ]; then
    exec "$PYTHON_BIN" "$INSTALL_DIR/install_deps.py" "$@" </dev/tty
else
    exec "$PYTHON_BIN" "$INSTALL_DIR/install_deps.py" "$@"
fi